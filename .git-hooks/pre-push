#!/bin/bash

# Pre-push hook for Arbitrum-sequencer-decoder project
# Performs checks before allowing a push

# Determine the destination branch being pushed to
while read local_ref local_sha remote_ref remote_sha; do
    # Skip checks for tags
    if echo "$remote_ref" | grep -q "^refs/tags/"; then
        echo "Pushing tag: $remote_ref - skipping branch checks"
        continue
    fi

    DEST_BRANCH=$(echo "$remote_ref" | sed 's|refs/heads/||')

    echo "Running pre-push checks for branch: $DEST_BRANCH"

    # Function to check if a command exists
    command_exists() {
        command -v "$1" >/dev/null 2>&1
    }

    # Run tests before pushing to develop or main
    if [ "$DEST_BRANCH" = "master" ] || [ "$DEST_BRANCH" = "main" ] || [ "$DEST_BRANCH" = "develop" ]; then
        echo "Running tests before pushing to protected branch..."
        if command_exists go; then
            # Check if there are any Go test files before running tests
            if [ -n "$(find . -name "*_test.go" -type f)" ]; then
                if ! go test ./... -v 2>/dev/null; then
                    echo "Error: Tests failed, cannot push to $DEST_BRANCH"
                    exit 1
                fi
            else
                echo "No test files found, skipping tests for now"
            fi
        else
            echo "Warning: go not found, skipping tests"
        fi
    fi

    # Check branch naming convention for non-protected branches
    if [ "$DEST_BRANCH" != "master" ] && [ "$DEST_BRANCH" != "main" ] && [ "$DEST_BRANCH" != "develop" ]; then
        # Check if the branch follows the expected patterns
        if ! echo "$DEST_BRANCH" | grep -E "^(feature|fix|hotfix|release)/.*" > /dev/null 2>&1; then
            echo "Error: Branch name '$DEST_BRANCH' does not follow convention."
            echo "Expected format: feature/issue-description, fix/issue-description, hotfix/issue-description, or release/version"
            exit 1
        fi
    fi
done

# Check if we're in the right directory
if [ ! -f "go.mod" ]; then
    echo "Not in project root directory, skipping pre-push checks"
    exit 0
fi

echo "Pre-push checks passed!"
exit 0
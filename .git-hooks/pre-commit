#!/bin/bash

# Pre-commit hook for Arbitrum-sequencer-decoder project
# Performs quality checks before allowing a commit

echo "Running pre-commit checks..."

# Check if we're in the right directory
if [ ! -f "go.mod" ]; then
    echo "Not in project root directory, skipping pre-commit checks"
    exit 0
fi

# Function to check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Run Go formatting check
echo "Checking Go formatting..."
if command_exists gofmt; then
    # Find all .go files that are staged for commit
    FORMATTING_ISSUES=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.go$' | xargs gofmt -l 2>/dev/null)
    if [ -n "$FORMATTING_ISSUES" ]; then
        echo "Error: The following files are not properly formatted:"
        echo "$FORMATTING_ISSUES"
        echo "Run 'gofmt -w <files>' or 'go fmt ./...' to fix formatting"
        exit 1
    fi
else
    echo "Warning: gofmt not found, skipping formatting check"
fi

# Run Go vet
echo "Running go vet..."
if command_exists go; then
    # Check only the files that are staged for commit
    GO_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.go$' | tr '\n' ' ')
    if [ -n "$GO_FILES" ]; then
        if ! go vet $GO_FILES 2>/dev/null; then
            echo "Error: go vet found issues"
            go vet $GO_FILES
            exit 1
        fi
    fi
else
    echo "Warning: go not found, skipping go vet"
fi

# Check for commit message format
COMMIT_MSG=$(git log --format=%B -n 1 HEAD)
if ! echo "$COMMIT_MSG" | grep -E "^(feat|fix|docs|style|refactor|perf|test|chore)(\(.+\))?: .+" >/dev/null 2>&1; then
    echo "Warning: Commit message does not follow conventional format:"
    echo "Should be in format: type(scope): description"
    echo "Example: feat(uniswap_v3): add decoder for exactInput swaps"
    echo "Current message: $COMMIT_MSG"
    # For now, just warn but don't fail - we can make this strict later
fi

# Check for secrets in staged files
echo "Scanning for potential secrets..."
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
for file in $STAGED_FILES; do
    if [[ $file == *.go ]]; then
        # Look for potential API keys, private keys, or other secrets
        if git show ":$file" | grep -i -E "(apikey|secret|password|privatekey|token|credential|passwd|pwd)" | grep -v -i "comment" | grep -v -i "placeholder" | grep -v -i "mock" | grep -v -i "test" | grep -v -i "example" > /dev/null; then
            echo "Warning: Potential secret found in $file"
            git show ":$file" | grep -n -i -E "(apikey|secret|password|privatekey|token|credential|passwd|pwd)" | grep -v -i "comment" | grep -v -i "placeholder" | grep -v -i "mock" | grep -v -i "test" | grep -v -i "example"
        fi
    fi
done

echo "Pre-commit checks passed!"
exit 0